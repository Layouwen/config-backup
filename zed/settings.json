{
  // ----------------- 语言格式化配置 start -----------------
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": [],
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
  },
  // ----------------- 语言格式化配置 end -----------------

  // ----------------- 语言服务器配置 start -----------------
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto",
        },
      },
    },
  },
  // ----------------- 语言服务器配置 end -----------------

  // ----------------- AI 自动补全配置 start -----------------
  "edit_predictions": {
    "mode": "eager",
    "provider": "zed",
    "open_ai_compatible_api": {
      "max_output_tokens": 512,
      "prompt_format": "deepseek_coder",
      "model": "deepseek-v4-pro",
      "api_url": "https://api.deepseek.com/beta/completions",
    },
  },
  // ----------------- AI 自动补全配置 end -----------------

  // ----------------- AI 助手配置 start -----------------
  "agent": {
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
    },
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access",
      },
      "type": "registry",
    },
  },
  // ----------------- AI 助手配置 end -----------------

  // ----------------- 外观主题配置 start -----------------
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  // ----------------- 外观主题配置 end -----------------

  // ----------------- 面板布局配置 start -----------------
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
    "button": true,
  },
  // ----------------- 面板布局配置 end -----------------

  // ----------------- 终端配置 start -----------------
  "terminal": {
    "env": {
      "Q_NEW_SESSION": "\"1\"",
      "FIG_NEW_SESSION": "\"1\"",
    },
  },
  // ----------------- 终端配置 end -----------------

  // ----------------- 编辑器基础配置 start -----------------
  "proxy": "",
  "base_keymap": "JetBrains",
  "preview_tabs": {
    "enabled": false,
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "always",
  },
  "line_ending": "prefer_lf",
  "tab_size": 2,
  "vim_mode": true,
  // ----------------- 编辑器基础配置 end -----------------

  // ----------------- 字体配置 start -----------------
  "buffer_font_fallbacks": ["Consolas", "Courier New", "monospace"],
  "buffer_font_family": "JetBrains Mono",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "file_types": {
    "JavaScript": ["*.wxs"],
    "JSONC": ["*.cjson"],
    "CSS": ["*.wxss"],
  },
  // ----------------- 字体配置 end -----------------
}

