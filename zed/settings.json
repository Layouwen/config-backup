{
  "icon_theme": "Material Icon Theme",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "env": {
      "Q_NEW_SESSION": "\"1\"",
      "FIG_NEW_SESSION": "\"1\"",
    },
  },
  "proxy": "",
  "base_keymap": "JetBrains",
  "preview_tabs": {
    "enabled": false,
  },
  "git_panel": {
    "dock": "right",
    "button": true,
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "always",
  },
  "buffer_font_fallbacks": ["Consolas", "Courier New", "monospace"],
  "buffer_font_family": "JetBrains Mono",
  "file_types": {
    "javascript": ["*.wxs"],
    "jsonc": ["*.cjson"],
    "css": ["*.wxss"],
  },
  "show_edit_predictions": true,
  "line_ending": "prefer_lf",
  "tab_size": 2,
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "fast-mode": "on",
        "mode": "agent-full-access",
        "reasoning_effort": "xhigh",
      },
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}

